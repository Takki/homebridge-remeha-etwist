{
  "pluginAlias": "RemehaHome",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Control your Remeha eTwist thermostat through the Remeha Home cloud. Use the same account you use in the Remeha Home app.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Remeha eTwist"
      },
      "email": {
        "title": "Remeha Home email",
        "type": "string",
        "format": "email"
      },
      "password": {
        "title": "Remeha Home password",
        "type": "string",
        "x-schema-form": {
          "type": "password"
        }
      },
      "pollInterval": {
        "title": "Poll interval (seconds)",
        "type": "integer",
        "default": 60,
        "minimum": 30,
        "maximum": 3600
      },
      "setpointChangeInScheduleMode": {
        "title": "Temperature change while on schedule",
        "type": "string",
        "default": "temporary",
        "oneOf": [
          {
            "title": "Temporary override until next schedule switch",
            "enum": [
              "temporary"
            ]
          },
          {
            "title": "Switch to manual mode",
            "enum": [
              "manual"
            ]
          }
        ]
      },
      "exposeProgramSwitches": {
        "title": "Show heating program switches (Program 1, 2, 3)",
        "type": "boolean",
        "default": true
      },
      "cooling": {
        "title": "Cooling",
        "description": "The heat pump decides when it cools; this only adds the Cool mode in the Home app.",
        "type": "string",
        "default": "auto",
        "oneOf": [
          {
            "title": "Automatic (show once the heat pump reports cooling)",
            "enum": [
              "auto"
            ]
          },
          {
            "title": "Always show cooling",
            "enum": [
              "on"
            ]
          },
          {
            "title": "Never show cooling",
            "enum": [
              "off"
            ]
          }
        ]
      },
      "exposeHotWater": {
        "title": "Show hot water as a thermostat",
        "type": "boolean",
        "default": true
      },
      "exposeOutdoorTemperature": {
        "title": "Show outdoor temperature sensor",
        "type": "boolean",
        "default": true
      },
      "exposeWaterPressureAlert": {
        "title": "Show low water pressure alert (leak sensor)",
        "type": "boolean",
        "default": true
      },
      "exposeHolidayMode": {
        "title": "Show holiday mode (occupancy sensor, detected = holiday mode on)",
        "type": "boolean",
        "default": true
      },
      "mqtt": {
        "title": "MQTT (e.g. LoxBerry MQTT Gateway, Home Assistant, Node-RED)",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "Publish to MQTT",
            "type": "boolean",
            "default": false
          },
          "host": {
            "title": "Broker host",
            "type": "string",
            "placeholder": "192.168.0.10 or mqtts://broker:8883"
          },
          "port": {
            "title": "Broker port",
            "type": "integer",
            "default": 1883
          },
          "username": {
            "title": "Username",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string",
            "x-schema-form": {
              "type": "password"
            }
          },
          "topicPrefix": {
            "title": "Topic prefix",
            "type": "string",
            "default": "remeha"
          },
          "allowControl": {
            "title": "Accept commands on <topic>/set",
            "description": "Off by default so MQTT can't conflict with other heat pump control such as SG Ready.",
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "required": [
      "name",
      "email",
      "password"
    ]
  }
}
